<Page
    x:Class="NotifyRelayGamebar.PlayerWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NotifyRelayGamebar.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotifyRelayGamebar"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    d:Height="200"
    d:Width="350"
    mc:Ignorable="d">

    <Page.Resources>
            <!-- Shuffle/Repeat templates removed because buttons were removed -->
            <converters:CollectionToVisibilityConverter x:Key="collectionToVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="boolToVisibilityConverter" />
        </Page.Resources>

    <Grid>
        <Grid x:Name="BackgroundGrid" />

        <!-- 通知显示区域 -->
        <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
            <ContentControl x:Name="RootContentControl" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="RootStackPanel" Orientation="Vertical">
                    <!-- 改为 Stretch，使子通知可以横向填满小部件限制宽度 -->
                    <StackPanel x:Name="ToastStack" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Orientation="Vertical">
                        <!-- 媒体控制区域作为通知块，仅在有媒体会话时显示 -->
                        <Border
                            x:Name="PlayerWidgetView"
                            d:Visibility="Visible"
                            Margin="6,4"
                            Padding="8"
                            CornerRadius="6,6,6,6"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            HorizontalAlignment="Stretch"
                            BorderThickness="2"
                            BorderBrush="White">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 会话切换按钮已移除，保留中间播放控件 -->

                        <Grid Grid.Column="1" Margin="5,0" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="6">
                                    <Image
                                        Grid.Column="0"
                                        Width="50"
                                        MaxHeight="50"
                                        VerticalAlignment="Center"
                                        d:Source="/Assets/StoreLogo.png"
                                        Source="{x:Bind PlayerViewModel.ThumbnailImageSource, Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        d:Text="Title"
                                        FontWeight="Bold"
                                        FontSize="14"
                                        Text="{x:Bind PlayerViewModel.Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        d:Text="Artist"
                                        FontSize="12"
                                        Text="{x:Bind PlayerViewModel.Artist, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        d:Text="Album"
                                        FontSize="12"
                                        Text="{x:Bind PlayerViewModel.Album, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Shuffle 按钮已移除 -->
                                <StackPanel
                                    x:Name="PlaybackControlsPanel"
                                    Grid.Column="1"
                                    Padding="5,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="PreviousButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="PreviousButton_Click"
                                        IsEnabled="{x:Bind PlayerViewModel.IsPreviousEnabled, Mode=OneWay}">
                                        <FontIcon Glyph="&#xF8AC;" />
                                    </Button>
                                    <Button
                                        x:Name="PlayPauseButton"
                                        Width="40"
                                        Height="40"
                                        Margin="8,0"
                                        Padding="5"
                                        Click="PlayPauseButton_Click"
                                        CornerRadius="20"
                                        IsEnabled="{x:Bind PlayerViewModel.IsPlayPauseEnabled, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <Button.Content>
                                            <FontIcon 
                                                d:Glyph="&#xF5B0;" 
                                                Glyph="{x:Bind local:PlayerBindingExtensions.IsPlayingGlyph(PlayerViewModel.IsPlaying), Mode=OneWay}"
                                                FontSize="20" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Center" />
                                        </Button.Content>
                                    </Button>
                                    <Button
                                        x:Name="NextButton"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="NextButton_Click"
                                        IsEnabled="{x:Bind PlayerViewModel.IsNextEnabled, Mode=OneWay}">
                                        <FontIcon Glyph="&#xF8AD;" />
                                    </Button>
                                </StackPanel>
                                <!-- Repeat 按钮已移除 -->
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 其他通知将通过代码动态添加到这里 -->
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Page>
