<Page
    x:Class="NotifyRelayGamebar.NotifyRelayWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NotifyRelayGamebar.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotifyRelayGamebar"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:NotifyRelayGamebar.Models"
    d:Height="200"
    d:Width="350"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Shuffle/Repeat templates removed because buttons were removed -->
        <converters:CollectionToVisibilityConverter x:Key="collectionToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="boolToVisibilityConverter" />
        <LinearGradientBrush x:Key="WinIslandSpectrumBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A8E7FF" Offset="0" />
            <GradientStop Color="#63E6C6" Offset="1" />
        </LinearGradientBrush>
        
        <!-- WinIsland 风格的样式 -->
        <Style x:Key="WinIslandMediaItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Opacity="0.8" Color="#000000" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="8" />
        </Style>
        
        <Style x:Key="WinIslandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style x:Key="WinIslandPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style x:Key="WinIslandTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <Style x:Key="WinIslandSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <Style x:Key="WinIslandDeviceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WinIslandSuperIslandItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Opacity="0.8" Color="#000000" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="10" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- 背景Grid，设置透明背景避免显示方形淡色背景 -->
        <Grid x:Name="BackgroundGrid" Background="{x:Null}" IsHitTestVisible="False" />

        <!-- 通知显示区域 -->
        <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" Background="{x:Null}">
            <ContentControl x:Name="RootContentControl" HorizontalContentAlignment="Stretch" Background="{x:Null}">
                <StackPanel x:Name="RootStackPanel" Orientation="Vertical" Background="{x:Null}">
                    <!-- 改为 Stretch，使子通知可以横向填满小部件限制宽度 -->
                    <StackPanel x:Name="ToastStack" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,0,10,10" Orientation="Vertical" Background="{x:Null}">
                        <!-- 媒体控制区域作为通知块，仅在有媒体会话时显示 -->
                        <!-- 使用 ItemsControl 显示多个媒体块 -->
                        <ItemsControl
                            x:Name="PlayerWidgetView"
                            d:Visibility="Visible"
                            Margin="6,8,6,8"
                            ItemsSource="{x:Bind PlayerViewModel.MediaSessions, Mode=OneWay}"
                            Background="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaSessionViewModel">
                                    <!-- WinIsland 风格的媒体项，支持点击展开/收起 -->
                                    <Border 
                                        Style="{StaticResource WinIslandMediaItemStyle}"
                                        Tapped="MediaItem_Tapped"
                                        HorizontalAlignment="Center"
                                        DataContext="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 收起状态 - WinIsland 风格 -->
                                            <Grid Grid.Row="0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 专辑封面 -->
                                                <Border 
                                                    x:Name="CoverBorder"
                                                    Width="18" 
                                                    Height="18" 
                                                    CornerRadius="5">
                                                    <Image
                                                        x:Name="CoverImage"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        d:Source="/Assets/StoreLogo.png"
                                                        Source="{x:Bind ThumbnailImageSource, Mode=OneWay}"
                                                        Stretch="Uniform" />
                                                </Border>

                                                <!-- 歌曲信息 - 单行滚动显示 -->
                                                <Grid
                                                    x:Name="TitleMarqueeHost"
                                                    Grid.Column="1"
                                                    Margin="8,0,8,0"
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    Loaded="TitleMarqueeHost_Loaded"
                                                    Unloaded="TitleMarqueeHost_Unloaded"
                                                    SizeChanged="TitleMarqueeHost_SizeChanged"
                                                    DataContextChanged="TitleMarqueeHost_DataContextChanged">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock 
                                                            x:Name="TitleText"
                                                            Text="{x:Bind Title, Mode=OneWay}" 
                                                            FontSize="12"
                                                            FontWeight="Normal"
                                                            Foreground="White"
                                                            HorizontalAlignment="Left"
                                                            TextWrapping="NoWrap"
                                                            TextTrimming="None">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform />
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 播放状态指示器 -->
                                                <Grid 
                                                    x:Name="PlayIndicator"
                                                    Grid.Column="2"
                                                    Width="20" 
                                                    Height="18" 
                                                    VerticalAlignment="Center"
                                                    DataContextChanged="PlayIndicator_DataContextChanged"
                                                    Loaded="PlayIndicator_Loaded"
                                                    Unloaded="PlayIndicator_Unloaded">
                                                        <Grid.Resources>
                                                            <Storyboard x:Name="SpectrumStoryboard" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="Bar1Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="0.55" Duration="0:0:0.75" BeginTime="0:0:0.00" />
                                                                <DoubleAnimation Storyboard.TargetName="Bar2Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="0.70" Duration="0:0:0.75" BeginTime="0:0:0.15" />
                                                                <DoubleAnimation Storyboard.TargetName="Bar3Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="0.85" Duration="0:0:0.75" BeginTime="0:0:0.30" />
                                                                <DoubleAnimation Storyboard.TargetName="Bar4Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="1.00" Duration="0:0:0.75" BeginTime="0:0:0.45" />
                                                                <DoubleAnimation Storyboard.TargetName="Bar5Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="1.15" Duration="0:0:0.75" BeginTime="0:0:0.60" />
                                                                <DoubleAnimation Storyboard.TargetName="Bar6Scale" Storyboard.TargetProperty="ScaleY" From="0.20" To="1.30" Duration="0:0:0.75" BeginTime="0:0:0.75" />
                                                            </Storyboard>
                                                        </Grid.Resources>
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                            <Rectangle x:Name="Bar1" Width="2" Height="14" Margin="0,0,1,0" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar1Scale" ScaleY="0.35" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle x:Name="Bar2" Width="2" Height="14" Margin="0,0,1,0" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar2Scale" ScaleY="0.45" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle x:Name="Bar3" Width="2" Height="14" Margin="0,0,1,0" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar3Scale" ScaleY="0.55" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle x:Name="Bar4" Width="2" Height="14" Margin="0,0,1,0" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar4Scale" ScaleY="0.40" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle x:Name="Bar5" Width="2" Height="14" Margin="0,0,1,0" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar5Scale" ScaleY="0.30" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle x:Name="Bar6" Width="2" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource WinIslandSpectrumBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                                <Rectangle.RenderTransform>
                                                                    <ScaleTransform x:Name="Bar6Scale" ScaleY="0.50" />
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                        </StackPanel>
                                                    </Grid>
                                            </Grid>
                                            
                                            <!-- 展开状态 -->
                                            <Grid 
                                                x:Name="ExpandedPanel"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <!-- 封面和文本在同一行 -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- 歌曲信息 -->
                                                    <StackPanel 
                                                        Grid.Column="1" 
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Top">
                                                        <!-- 歌曲标题 -->
                                                        <Grid
                                                            x:Name="ExpandedTitleMarqueeHost"
                                                            Loaded="TitleMarqueeHost_Loaded"
                                                            Unloaded="TitleMarqueeHost_Unloaded"
                                                            SizeChanged="TitleMarqueeHost_SizeChanged"
                                                            DataContextChanged="TitleMarqueeHost_DataContextChanged">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock 
                                                                    x:Name="ExpandedTitle"
                                                                    Style="{StaticResource WinIslandTitleTextStyle}"
                                                                    Text="{x:Bind Title, Mode=OneWay}" 
                                                                    HorizontalAlignment="Left"
                                                                    TextWrapping="NoWrap"
                                                                    TextTrimming="None"
                                                                    Opacity="0">
                                                                    <TextBlock.RenderTransform>
                                                                        <TranslateTransform />
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <!-- 艺术家 -->
                                                        <TextBlock 
                                                            x:Name="ExpandedArtist"
                                                            Style="{StaticResource WinIslandSubtitleTextStyle}"
                                                            Text="{x:Bind Artist, Mode=OneWay}" 
                                                            Margin="0,4,0,0"
                                                            Opacity="0"/>
                                                        
                                                        <!-- 设备名称 -->
                                                        <TextBlock 
                                                            x:Name="ExpandedDevice"
                                                            FontSize="10"
                                                            Foreground="#999999"
                                                            Text="{x:Bind DeviceName, Mode=OneWay}" 
                                                            Margin="0,2,0,0"
                                                            Opacity="0"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- 控制按钮（左右居中） -->
                                                <StackPanel
                                                    x:Name="ExpandedControls"
                                                    Grid.Row="1"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Opacity="0">
                                                    <Button
                                                        Style="{StaticResource WinIslandButtonStyle}"
                                                        Click="PreviousButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsPreviousEnabled, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xF8AC;" FontSize="16" />
                                                    </Button>
                                                    <Button
                                                        Style="{StaticResource WinIslandPlayButtonStyle}"
                                                        Click="PlayPauseButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsPlayPauseEnabled, Mode=OneWay}">
                                                        <Button.Content>
                                                            <FontIcon 
                                                                d:Glyph="&#xF5B0;" 
                                                                Glyph="{x:Bind local:PlayerBindingExtensions.IsPlayingGlyph(IsPlaying), Mode=OneWay}"
                                                                FontSize="18" 
                                                                VerticalAlignment="Center" 
                                                                HorizontalAlignment="Center" />
                                                        </Button.Content>
                                                    </Button>
                                                    <Button
                                                        Style="{StaticResource WinIslandButtonStyle}"
                                                        Click="NextButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsNextEnabled, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xF8AD;" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl
                            x:Name="SuperIslandView"
                            d:Visibility="Visible"
                            Margin="6,8,6,8"
                            ItemsSource="{x:Bind NotificationViewModel.SuperIslands, Mode=OneWay}"
                            Visibility="{x:Bind NotificationViewModel.HasSuperIslands, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}"
                            Background="{x:Null}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SuperIslandViewModel">
                                    <Border
                                        Style="{StaticResource WinIslandSuperIslandItemStyle}"
                                        Tapped="SuperIslandItem_Tapped"
                                        HorizontalAlignment="Center"
                                        DataContext="{Binding}">
                                        <Grid>
                                            <StackPanel
                                                x:Name="SmallPanel"
                                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}, ConverterParameter=True}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="20"
                                                        Height="20"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}">
                                                        <Image
                                                            Width="20"
                                                            Height="20"
                                                            Source="{x:Bind ImageSource, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                        <TextBlock
                                                            Text="{x:Bind Title, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandTitleTextStyle}"
                                                            FontSize="12" />
                                                        <TextBlock
                                                            Text="{x:Bind SubTitle, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandSubtitleTextStyle}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind TimerText, Mode=OneWay}"
                                                        Style="{StaticResource WinIslandDeviceTextStyle}"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasTimer, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}" />
                                                </Grid>

                                                <ProgressBar
                                                    Margin="0,6,0,0"
                                                    Maximum="100"
                                                    Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                    Visibility="{x:Bind HasProgress, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <StackPanel
                                                x:Name="ExpandedPanel"
                                                Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="48"
                                                        Height="48"
                                                        CornerRadius="10"
                                                        VerticalAlignment="Top"
                                                        Visibility="{x:Bind HasImage, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}">
                                                        <Image
                                                            Width="48"
                                                            Height="48"
                                                            Source="{x:Bind ImageSource, Mode=OneWay}"
                                                            Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock
                                                            Text="{x:Bind Title, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandTitleTextStyle}" />
                                                        <TextBlock
                                                            Text="{x:Bind SubTitle, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandSubtitleTextStyle}"
                                                            Margin="0,4,0,0" />
                                                        <TextBlock
                                                            Text="{x:Bind Extra, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandSubtitleTextStyle}"
                                                            Margin="0,2,0,0"
                                                            Visibility="{x:Bind HasExtra, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}" />
                                                        <TextBlock
                                                            Text="{x:Bind DeviceName, Mode=OneWay}"
                                                            Style="{StaticResource WinIslandDeviceTextStyle}"
                                                            Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock
                                                        Text="{x:Bind TimerText, Mode=OneWay}"
                                                        Style="{StaticResource WinIslandDeviceTextStyle}"
                                                        Visibility="{x:Bind HasTimer, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}" />
                                                    <ProgressBar
                                                        Margin="0,6,0,0"
                                                        Maximum="100"
                                                        Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                        Visibility="{x:Bind HasProgress, Mode=OneWay, Converter={StaticResource boolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 其他通知将通过代码动态添加到这里 -->
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </ScrollViewer>

    </Grid>
</Page>
