<Page
    x:Class="NotifyRelayGamebar.NotifyRelayWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NotifyRelayGamebar.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotifyRelayGamebar"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:NotifyRelayGamebar.Models"
    d:Height="200"
    d:Width="350"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Shuffle/Repeat templates removed because buttons were removed -->
        <converters:CollectionToVisibilityConverter x:Key="collectionToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="boolToVisibilityConverter" />
        
        <!-- WinIsland 风格的样式 -->
        <Style x:Key="WinIslandMediaItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Opacity="0.8" Color="#000000" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="8" />
        </Style>
        
        <Style x:Key="WinIslandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style x:Key="WinIslandPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        
        <Style x:Key="WinIslandTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <Style x:Key="WinIslandSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <Style x:Key="WinIslandDeviceTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- 背景Grid，设置透明背景避免显示方形淡色背景 -->
        <Grid x:Name="BackgroundGrid" Background="Transparent" />

        <!-- 通知显示区域 -->
        <ScrollViewer x:Name="RootScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" Background="Transparent">
            <ContentControl x:Name="RootContentControl" HorizontalContentAlignment="Stretch" Background="Transparent">
                <StackPanel x:Name="RootStackPanel" Orientation="Vertical" Background="Transparent">
                    <!-- 改为 Stretch，使子通知可以横向填满小部件限制宽度 -->
                    <StackPanel x:Name="ToastStack" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10" Orientation="Vertical" Background="Transparent">
                        <!-- 媒体控制区域作为通知块，仅在有媒体会话时显示 -->
                        <!-- 使用 ItemsControl 显示多个媒体块 -->
                        <ItemsControl
                            x:Name="PlayerWidgetView"
                            d:Visibility="Visible"
                            Margin="6,8,6,8"
                            ItemsSource="{x:Bind PlayerViewModel.MediaSessions, Mode=OneWay}"
                            Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaSessionViewModel">
                                    <!-- WinIsland 风格的媒体项，支持点击展开/收起 -->
                                    <Border 
                                        Style="{StaticResource WinIslandMediaItemStyle}"
                                        Tapped="MediaItem_Tapped">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- 收起状态 - WinIsland 风格 -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 专辑封面 -->
                                                <Border 
                                                    x:Name="CoverBorder"
                                                    Grid.Column="0" 
                                                    Width="18" 
                                                    Height="18" 
                                                    CornerRadius="5">
                                                    <Image
                                                        x:Name="CoverImage"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        d:Source="/Assets/StoreLogo.png"
                                                        Source="{x:Bind ThumbnailImageSource, Mode=OneWay}"
                                                        Stretch="Uniform" />
                                                </Border>
                                                
                                                <!-- 歌曲信息 -->
                                                <TextBlock 
                                                    x:Name="TitleText"
                                                    Grid.Column="1" 
                                                    Margin="8,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title, Mode=OneWay}" 
                                                    FontSize="12"
                                                    FontWeight="Normal"
                                                    Foreground="White"
                                                    TextTrimming="CharacterEllipsis"/>
                                                
                                                <!-- 播放状态指示器 -->
                                                <Grid 
                                                    x:Name="PlayIndicator"
                                                    Grid.Column="2" 
                                                    Width="20" 
                                                    Height="18" 
                                                    VerticalAlignment="Center">
                                                    <TextBlock 
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="#CCCCCC">
                                                        <Run Text="{x:Bind local:PlayerBindingExtensions.IsPlayingGlyph(IsPlaying), Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                            
                                            <!-- 展开状态 -->
                                            <Grid 
                                                x:Name="ExpandedPanel"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                
                                                <!-- 封面和文本在同一行 -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- 歌曲信息 -->
                                                    <StackPanel 
                                                        Grid.Column="1" 
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Top">
                                                        <!-- 歌曲标题 -->
                                                        <TextBlock 
                                                            x:Name="ExpandedTitle"
                                                            Style="{StaticResource WinIslandTitleTextStyle}"
                                                            Text="{x:Bind Title, Mode=OneWay}" 
                                                            TextTrimming="CharacterEllipsis"
                                                            Opacity="0"/>
                                                        
                                                        <!-- 艺术家 -->
                                                        <TextBlock 
                                                            x:Name="ExpandedArtist"
                                                            Style="{StaticResource WinIslandSubtitleTextStyle}"
                                                            Text="{x:Bind Artist, Mode=OneWay}" 
                                                            Margin="0,4,0,0"
                                                            Opacity="0"/>
                                                        
                                                        <!-- 设备名称 -->
                                                        <TextBlock 
                                                            x:Name="ExpandedDevice"
                                                            FontSize="10"
                                                            Foreground="#999999"
                                                            Text="{x:Bind DeviceName, Mode=OneWay}" 
                                                            Margin="0,2,0,0"
                                                            Opacity="0"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- 控制按钮（左右居中） -->
                                                <StackPanel
                                                    x:Name="ExpandedControls"
                                                    Grid.Row="1"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Opacity="0">
                                                    <Button
                                                        Style="{StaticResource WinIslandButtonStyle}"
                                                        Click="PreviousButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsPreviousEnabled, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xF8AC;" FontSize="16" />
                                                    </Button>
                                                    <Button
                                                        Style="{StaticResource WinIslandPlayButtonStyle}"
                                                        Click="PlayPauseButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsPlayPauseEnabled, Mode=OneWay}">
                                                        <Button.Content>
                                                            <FontIcon 
                                                                d:Glyph="&#xF5B0;" 
                                                                Glyph="{x:Bind local:PlayerBindingExtensions.IsPlayingGlyph(IsPlaying), Mode=OneWay}"
                                                                FontSize="18" 
                                                                VerticalAlignment="Center" 
                                                                HorizontalAlignment="Center" />
                                                        </Button.Content>
                                                    </Button>
                                                    <Button
                                                        Style="{StaticResource WinIslandButtonStyle}"
                                                        Click="NextButton_Click"
                                                        CommandParameter="{x:Bind DeviceId}"
                                                        IsEnabled="{x:Bind IsNextEnabled, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xF8AD;" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 其他通知将通过代码动态添加到这里 -->
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Page>
